# Intuit Developer app credentials. Create an app at
# https://developer.intuit.com/, copy the production (or sandbox) keys,
# and paste them here. The MCP server uses these to refresh access tokens
# at runtime.
QBO_CLIENT_ID=replace-me
QBO_CLIENT_SECRET=replace-me

# Long-lived OAuth refresh token. Obtained once via Intuit's authorize
# flow — see the README "One-time OAuth setup" section for the 60-second
# walkthrough using the Intuit OAuth Playground.
#
# IMPORTANT: refresh tokens rotate on every refresh. Persist the new token
# returned by the server (subscribe to QBOClient.on_refresh_token_rotated)
# so your deployment doesn't lose the ability to refresh after restart.
QBO_REFRESH_TOKEN=replace-me

# QBO Realm ID (a.k.a. Company ID). Returned alongside the refresh token
# during the OAuth flow. Scopes every API call to one company.
QBO_REALM_ID=replace-me

# QBO environment: "production" (default) or "sandbox". Sandbox uses
# https://sandbox-quickbooks.api.intuit.com; production uses
# https://quickbooks.api.intuit.com. Your client_id / client_secret /
# refresh_token must match the chosen environment.
QBO_ENVIRONMENT=production

# Optional: Intuit minorversion to request. Pin this if your tools depend
# on fields introduced in a specific QBO release. Leave blank to use the
# Intuit account default. See:
# https://developer.intuit.com/app/developer/qbapi/docs/learn/explore-the-quickbooks-online-api/minor-versions
QBO_MINOR_VERSION=

# Optional: HTTP request timeout in seconds. Default 60.
QBO_HTTP_TIMEOUT=60

# Optional: number of retry attempts on transient errors (5xx, 429, timeout). Default 3.
QBO_MAX_RETRIES=3
